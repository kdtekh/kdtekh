# Habilitar el motor de reescritura
RewriteEngine On

# Establecer la ruta base para las reglas de reescritura
RewriteBase /admin/

# Redirigir HTTP a HTTPS
RewriteCond %{HTTPS} off
RewriteRule ^(.*)$ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

# Evitar listado de directorios
Options -Indexes

# Manejar rutas de mensajes
RewriteRule ^mensajes/?$ mensajes/index.php [L,NC,QSA]

# Manejar rutas de newsletter
RewriteRule ^newsletter/?$ newsletter/index.php [L,NC,QSA]

# Si el archivo o directorio no existe, redirigir al index principal
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule . index.php [L]

# Configuración de PHP
php_flag display_errors on
php_value error_reporting E_ALL
php_value error_log /home/u507128367/domains/kdtekh.com/public_html/logs/php_errors.log

# Reglas para archivos y directorios existentes
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d

# Redirigir todo lo demás al index principal
RewriteRule ^(.*)$ index.php?url=$1 [L,QSA]

# Configuración de PHP para mostrar errores
php_flag display_errors on
php_value error_reporting E_ALL

# Configuración de zona horaria
date_default_timezone_set('America/Argentina/Buenos_Aires')

# Configuración de memoria
php_value memory_limit 256M
php_value max_execution_time 300
php_value upload_max_filesize 20M
php_value post_max_size 20M

# Deshabilitar listado de directorios
Options -Indexes

# Configuración para Apache (compatibilidad)
<IfModule mod_rewrite.c>
    RewriteEngine On
    
    # Redirigir HTTP a HTTPS
    RewriteCond %{HTTPS} off
    RewriteRule ^(.*)$ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]
    
    # Protección contra inyección de código
    RewriteCond %{QUERY_STRING} (\\<|%3C).*script.*(\\>|%3E) [NC,OR]
    RewriteCond %{QUERY_STRING} GLOBALS(=|\\[|\\%[0-9A-Z]{0,2}) [OR]
    RewriteCond %{QUERY_STRING} _REQUEST(=|\\[|\\%[0-9A-Z]{0,2}) [OR]
    # Bloquear intentos comunes de inyección SQL
    RewriteCond %{QUERY_STRING} (;|<|>|'|\"|\\|\.\./|\./|/\*\*/|/\*|--|#|%23|%27|%22) [NC,OR]
    RewriteCond %{QUERY_STRING} (sp_executesql|union.*select|insert\s+into|select.*from|update.*set|delete.*from) [NC]
    RewriteRule ^(.*)$ - [F,L]
    
    # Bloquear acceso a archivos ocultos
    RewriteRule ^\..*$ - [F,L]
    
    # Manejar rutas de administración
    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteCond %{REQUEST_FILENAME} !-d
    
    # Para rutas como /admin/mensajes/
    RewriteRule ^mensajes/(.*)$ mensajes/index.php?$1 [L,QSA]
    
    # Para rutas como /admin/newsletter/
    RewriteRule ^newsletter/(.*)$ newsletter/index.php?$1 [L,QSA]
    
    # Redirigir todo lo demás al index principal si no existe
    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteRule ^(.*)$ index.php?url=$1 [QSA,L]
</IfModule>

# ============================================
# Protección de archivos sensibles
# ============================================

# Bloquear acceso a archivos de configuración y código fuente
<FilesMatch "^(config\\.php|database\\.sql|update_database\\.sql|crear_admin\\.php|\\.htaccess|\\.env|composer\\.(json|lock)|package(-lock)?\\.json|webpack\\.config\\.js|yarn\\.lock|Gruntfile\\.js|gulpfile\\.js|phpunit\\.xml|README\\.md|CHANGELOG\\.md|UPGRADE\\.md|LICENSE|COPYING)$">
    <IfModule !mod_authz_core.c>
        Order allow,deny
        Deny from all
    </IfModule>
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
</FilesMatch>

# Bloquear archivos de desarrollo y control de versiones
<IfModule mod_rewrite.c>
    RewriteRule ^(composer\\.json|package\\.json|webpack\\.config\\.js|yarn\\.lock|package-lock\\.json|Gruntfile\\.js|gulpfile\\.js|phpunit\\.xml|README\\.md|CHANGELOG\\.md|UPGRADE\\.md|LICENSE|COPYING)$ - [F,L,NC]
</IfModule>

# Bloquear acceso a directorios de sistema
<IfModule mod_rewrite.c>
    RewriteRule ^(app|config|database|resources|storage|tests|vendor|node_modules|bower_components|tmp|temp|logs|log|cache|backup|uploads|downloads)/.*$ - [F,L,NC]
</IfModule>

# ============================================
# Configuración de cabeceras de seguridad
# ============================================
<IfModule mod_headers.c>
    # Protección XSS
    Header set X-XSS-Protection "1; mode=block"
    
    # Prevenir clickjacking
    Header always append X-Frame-Options SAMEORIGIN
    
    # Prevenir MIME type sniffing
    Header set X-Content-Type-Options "nosniff"
    
    # HSTS (HTTP Strict Transport Security)
    Header always set Strict-Transport-Security "max-age=31536000; includeSubDomains; preload"
    
    # Referrer Policy
    Header set Referrer-Policy "strict-origin-when-cross-origin"
    
    # Content Security Policy
    Header set Content-Security-Policy "default-src 'self' https: data: 'unsafe-inline' 'unsafe-eval';"
    
    # Permissions Policy
    Header set Permissions-Policy "geolocation=(), microphone=(), camera=(), payment=()"
    
    # X-Permitted-Cross-Domain-Policies
    Header set X-Permitted-Cross-Domain-Policies "none"
    
    # Feature Policy (obsoleto, pero para compatibilidad)
    Header set Feature-Policy "geolocation 'none'; microphone 'none'; camera 'none'"
    
    # Cache Control
    <FilesMatch "\\.(jpg|jpeg|png|gif|ico|css|js|woff|woff2|ttf|svg|eot)$">
        Header set Cache-Control "public, max-age=31536000, immutable"
    </FilesMatch>
    
    <FilesMatch "\\.(html|htm|php)$">
        Header set Cache-Control "no-store, no-cache, must-revalidate, max-age=0"
        Header set Pragma "no-cache"
    </FilesMatch>
</IfModule>

# ============================================
# Configuración de PHP
# ============================================
<IfModule mod_php7.c>
    php_flag display_errors Off
    php_flag log_errors On
    php_value error_log ../logs/php_errors.log
    php_value upload_max_filesize 20M
    php_value post_max_size 20M
    php_value max_execution_time 300
    php_value max_input_time 300
    php_flag session.cookie_httponly on
    php_flag session.cookie_secure on
    php_flag session.use_only_cookies on
    php_value session.cookie_samesite "Strict"
</IfModule>

# ============================================
# Configuraciones adicionales de seguridad
# ============================================

# Evitar que se vea el contenido de los directorios
IndexIgnore *

# Deshabilitar la firma del servidor
ServerSignature Off

# Deshabilitar el seguimiento de enlaces simbólicos
Options -FollowSymLinks

# Prevenir acceso a archivos ocultos
<FilesMatch "^\\.">
    <IfModule !mod_authz_core.c>
        Order allow,deny
        Deny from all
    </IfModule>
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
</FilesMatch>

# Protección contra hotlinking
<IfModule mod_rewrite.c>
    RewriteCond %{HTTP_REFERER} !^$
    RewriteCond %{HTTP_REFERER} !^https?://(www\\.)?tudominio\\.com [NC]
    RewriteRule \\.(jpg|jpeg|png|gif|svg|css|js)$ - [NC,F,L]
</IfModule>

# Comprimir archivos para mejorar el rendimiento
<IfModule mod_deflate.c>
    AddOutputFilterByType DEFLATE text/plain
    AddOutputFilterByType DEFLATE text/html
    AddOutputFilterByType DEFLATE text/xml
    AddOutputFilterByType DEFLATE text/css
    AddOutputFilterByType DEFLATE application/xml
    AddOutputFilterByType DEFLATE application/xhtml+xml
    AddOutputFilterByType DEFLATE application/rss+xml
    AddOutputFilterByType DEFLATE application/javascript
    AddOutputFilterByType DEFLATE application/x-javascript
    AddOutputFilterByType DEFLATE image/svg+xml
</IfModule>

# Configuración de caché para mejorar el rendimiento
<IfModule mod_expires.c>
    ExpiresActive On
    ExpiresByType image/jpg "access plus 1 year"
    ExpiresByType image/jpeg "access plus 1 year"
    ExpiresByType image/gif "access plus 1 year"
    ExpiresByType image/png "access plus 1 year"
    ExpiresByType text/css "access plus 1 month"
    ExpiresByType application/pdf "access plus 1 month"
    ExpiresByType text/x-javascript "access plus 1 month"
    ExpiresByType application/x-shockwave-flash "access plus 1 month"
    ExpiresByType image/x-icon "access plus 1 year"
    ExpiresDefault "access plus 2 days"
</IfModule>

# Bloquear acceso a archivos ocultos
<FilesMatch "^\.">
    Order allow,deny
    Deny from all
</FilesMatch>

# Permitir acceso solo desde ciertas IPs (opcional, descomenta y modifica según sea necesario)
#<RequireAll>
#    Require ip 192.168.1.0/24
#    # O para múltiples IPs
#    # Require ip 192.168.1.1 192.168.1.2
#</RequireAll>


# Redirigir a página de error personalizada
ErrorDocument 403 /periodico-digital/403.html
ErrorDocument 404 /periodico-digital/404.html
ErrorDocument 500 /periodico-digital/500.html
